{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Vite",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "http://127\\.0\\.0\\.1:5173/"
        }
      }
    },
    {
      "label": "Backend: FastAPI",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "fastapi",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^INFO:     Waiting for application startup\\.$",
          "endsPattern": "^INFO:     Application startup complete\\.$"
        }
      }
    },
    {
      "label": "Run Frontend and Backend",
      "dependsOn": ["Frontend: Vite", "Backend: FastAPI"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
